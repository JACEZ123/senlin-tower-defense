.root { position: relative; overflow: hidden; background: #1a1014; }
.game-canvas { position: absolute; left: 0; top: 0; }

/* 顶部 HUD */
.hud-top {
  position: absolute; left: 12px; right: 12px;
  display: flex; gap: 10px; align-items: center; z-index: 10;
  pointer-events: none;
}
.hud-pill {
  background: rgba(20,10,14,0.72); color: #ffe9c7;
  font-size: 28rpx; font-weight: 600;
  padding: 8rpx 20rpx; border-radius: 999px;
  border: 2rpx solid rgba(255,180,90,0.45);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.4);
}

/* 出怪按钮 */
.wave-btn {
  position: absolute; right: 16px; z-index: 11;
  margin-top: 56rpx;
  padding: 14rpx 30rpx; border-radius: 999px;
  font-size: 30rpx; font-weight: 700; color: #fff;
}
.wave-btn.ready {
  background: linear-gradient(180deg,#ff8a3d,#e8521b);
  box-shadow: 0 4rpx 12rpx rgba(232,82,27,0.5);
  border: 2rpx solid #ffd0a8;
}
.wave-btn.busy { background: rgba(40,24,28,0.8); color: #c8a98f; border: 2rpx solid rgba(255,180,90,0.3); }

/* 弹窗 */
.popup {
  position: absolute; left: 50%; bottom: 60rpx; transform: translateX(-50%);
  width: 640rpx; z-index: 20;
  background: rgba(28,16,20,0.96);
  border: 2rpx solid rgba(255,170,80,0.5);
  border-radius: 24rpx; padding: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(0,0,0,0.6);
}
.popup-title { color: #ffe9c7; font-size: 30rpx; font-weight: 700; text-align: center; margin-bottom: 18rpx; }
.tower-grid { display: flex; justify-content: space-between; }
.tower-card {
  width: 138rpx; background: rgba(255,255,255,0.06);
  border: 2rpx solid rgba(255,180,90,0.3); border-radius: 16rpx;
  padding: 12rpx 0; text-align: center;
}
.tower-card.disabled { opacity: 0.4; }
.tower-img { width: 96rpx; height: 96rpx; }
.tower-name { color: #ffe9c7; font-size: 24rpx; margin-top: 4rpx; }
.tower-cost { color: #ffd23f; font-size: 24rpx; font-weight: 600; }

.manage-row { display: flex; gap: 16rpx; justify-content: center; }
.btn {
  padding: 16rpx 28rpx; border-radius: 14rpx; font-size: 28rpx;
  font-weight: 700; color: #fff; text-align: center;
}
.btn.up { background: linear-gradient(180deg,#4fc3f7,#1976d2); }
.btn.up.disabled { opacity: 0.4; }
.btn.sell { background: linear-gradient(180deg,#9ccc65,#558b2f); }
.btn.maxed { background: rgba(255,200,100,0.25); color: #ffd23f; }
.btn.restart { background: linear-gradient(180deg,#ff8a3d,#e8521b); margin-top: 26rpx; }
.hint { color: #b6ff5a; font-size: 24rpx; text-align: center; margin-top: 16rpx; }
.popup-close { color: #c8a98f; font-size: 26rpx; text-align: center; margin-top: 18rpx; }

.tip {
  position: absolute; left: 0; right: 0; text-align: center; z-index: 9;
  color: #ffe9c7; font-size: 26rpx; opacity: 0.85;
  margin-bottom: 24rpx; pointer-events: none;
}

/* 胜负 */
.overlay {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0; z-index: 30;
  background: rgba(0,0,0,0.7); display: flex; align-items: center; justify-content: center;
}
.overlay-card {
  background: rgba(28,16,20,0.98); border: 2rpx solid rgba(255,170,80,0.5);
  border-radius: 28rpx; padding: 50rpx 60rpx; text-align: center;
}
.overlay-title { color: #ffe9c7; font-size: 46rpx; font-weight: 800; }
.overlay-sub { color: #c8a98f; font-size: 28rpx; margin-top: 14rpx; }

/* HUD 内联图标（替代 emoji） */
.pill-ic { width: 30rpx; height: 30rpx; vertical-align: middle; margin-right: 6rpx; }
